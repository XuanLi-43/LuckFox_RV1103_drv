/dts-v1/;

#include "rv1103.dtsi"
#include "rv1106-evb.dtsi"
#include "rv1103-luckfox-pico-ipc.dtsi"

/ {
	model = "Luckfox Pico Plus";
	compatible = "rockchip,rv1103g-38x38-ipc-v10", "rockchip,rv1103";

	/* dht11_sensor 定义于 rv1103-luckfox-pico-ipc.dtsi，占用 GPIO1_C7，
	 * 与 LCD 的 DC 引脚冲突，删除 */
	/delete-node/ dht11_sensor;
};

/**********SFC**********/
&sfc {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********SDMMC**********/
&sdmmc {
	max-frequency = <50000000>;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;

	//sdio
	cap-sdio-irq;
	non-removable;
	no-1-8-v;
	supports-sdio;

	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	status = "okay";
};

/**********ETH**********/
&gmac {
	status = "okay";
};

/**********USB**********/
&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

/**********SPI**********/
/* SPI0_M0 */
&spi0 {
	status = "disabled";
	spidev@0 {
		spi-max-frequency = <50000000>;
	};
	fbtft@0 {
		spi-max-frequency = <50000000>;
	};
};

/**********I2C**********/
/* I2C3_M1 */
&i2c3 {
	status = "disabled";
	clock-frequency = <100000>;
};

/* I2C0_M2 */
&i2c0 {
	status = "disabled";
	clock-frequency = <100000>;
};

/**********UART**********/
/* UART3_M1 */
&uart3 {
	status = "disabled";
};

/* UART4_M1 */
&uart4 {
	status = "disabled";
};

/**********PWM**********/
/* PWM1_M0 */
&pwm1 {
	status = "disabled";
};


/**********MD0240_LCD**********/
/* SPI0_M0: SCK=GPIO1_C1  MOSI=GPIO1_C2  CS0=GPIO1_C0
 * 引脚复用节点(clk/mosi/cs0)已定义在 rv1103-luckfox-pico-ipc.dtsi，无需自建 */
&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0m0_clk &spi0m0_mosi &spi0m0_cs0>;

	/* 继承自 rv1103-luckfox-pico-ipc.dtsi，与 md0240_lcd@0 同为 reg=<0>，关闭 */
	spidev@0 {
		status = "disabled";
	};
	fbtft@0 {
		status = "disabled";
	};

	md0240_lcd@0 {
		compatible = "atk_md0240,md0240_lcd";
		reg = <0>;
		spi-max-frequency = <6000000>;

		//引脚: GPIO1_C7_d
		dc-gpios = <&gpio1 RK_PC7 GPIO_ACTIVE_HIGH>; //低：写命令；高：写数据

		//引脚: GPIO1_C6_d
		rst-gpios = <&gpio1 RK_PC6 GPIO_ACTIVE_LOW>; //硬件复位引脚（低电平有效）

		//引脚: GPIO1_C5_d
		pwr-gpios = <&gpio1 RK_PC5 GPIO_ACTIVE_HIGH>; //低：关闭背光；高：开启背光
	};
};